# Copy to .env.local and fill in. Never commit real values. See README.md ("Environment variables").

# --- Supabase (server-side only: the service role key bypasses row level security) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe: TEST keys for development, LIVE keys for production. Never mix them. ---
# Test:  sk_test_... / rk_test_...   and the whsec_... printed by `stripe listen`
# Live:  sk_live_... / rk_live_...   and the whsec_... of your LIVE-mode webhook endpoint
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Unlock tokens: 32+ random characters (openssl rand -base64 48). Use a different value in production. ---
UNLOCK_TOKEN_SECRET=

# --- Free first big file: the key that makes the stored email hash one-way. 32+ random characters (openssl rand -base64 48). ---
# The email is stored only as HMAC-SHA256(this key, email), so it cannot be read back or guessed offline. Use a different value in
# production, and DO NOT change it later: every stored hash would stop matching, and people who already had their free file could claim another.
TRIAL_HASH_SECRET=

# --- Public site address: canonical URLs, sitemap, OpenGraph tags, Stripe return URLs and the links in the checkout consent text. ---
# Origin only (scheme + host), no path, no trailing slash. REQUIRED for a production build (it is baked in at build time,
# so rebuild after changing it). Use http://localhost:3000 for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin page (/admin): usage and payment numbers. 12+ characters. Leave empty to switch the page off. ---
ADMIN_PASSWORD=

# --- Stripe Tax: OFF by default. With it off, checkout works with no tax setup in Stripe and no tax is added. ---
# Set to true only after Stripe Tax is set up (Dashboard > Tax: head office address and registrations). It turns on
# automatic_tax and tax ID collection at checkout. Read when the app is BUILT (and when `npm run dev` starts), so rebuild
# or restart after changing it.
# ENABLE_STRIPE_TAX=true

# --- Rate limiting: Upstash Redis (optional, recommended on serverless hosting such as Vercel) ---
# With both set, the limits on checkout, unlock and admin login are shared by every server instance. Without them the
# counters live in each server's memory (fine for one server; per instance on serverless) and production logs a warning.
# Create a free database at https://console.upstash.com and copy the REST URL and token.
# UPSTASH_REDIS_REST_URL=https://<your-database>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- Only for `npm run e2e:stripe` (scripts/e2e-stripe.md) ---
# A TEST-mode key allowed to create refunds, if STRIPE_SECRET_KEY (restricted) is not. Never put a live key here.
# STRIPE_E2E_SECRET_KEY=sk_test_...
# Where the app under test runs (default http://localhost:3000).
# E2E_APP_URL=http://localhost:3000

# --- Optional ---
# Number of your own proxies in front of the app, for rate limiting (default 1).
# TRUSTED_PROXY_HOPS=1
# Older name for NEXT_PUBLIC_SITE_URL, still honoured for Stripe return URLs when that one is not set.
# APP_URL=
